generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model College {
  id          String   @id @default(uuid())

  name        String
  location    String

  fees        Int
  rating      Float

  overview    String

  placements  String
  courses     String

  imageUrl    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  savedBy SavedCollege[]
}

model User {
  id        String   @id @default(uuid())

  name      String
  email     String   @unique
  password  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedColleges SavedCollege[]
}

model SavedCollege {
  id         String   @id @default(uuid())

  userId     String
  collegeId  String

  user        User    @relation(fields: [userId], references: [id])
  college     College @relation(fields: [collegeId], references: [id])

  createdAt DateTime @default(now())
}